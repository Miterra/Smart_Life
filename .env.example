# ============================================================
#  Smart Life Dashboard - Variables d'environnement
#  Copie ce fichier vers .env.local et remplis les valeurs.
# ============================================================

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# Web Push (VAPID public, généré via `npm run gen:vapid`)
VITE_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optionnel - Comptes sociaux affichés sur le dashboard (handles publics)
VITE_INSTAGRAM_HANDLE=achmedia_
VITE_TIKTOK_HANDLE=achmedia
